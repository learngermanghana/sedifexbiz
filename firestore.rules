rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasMemberRecord() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid));
    }

    function memberData() {
      return get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data;
    }

    function hasDirectStoreAccess(storeId) {
      return hasMemberRecord()
        && memberData().uid == request.auth.uid
        && memberData().storeId == storeId;
    }

    function hasLinkedOwnerStoreAccess(storeId) {
      return hasMemberRecord()
        && memberData().uid == request.auth.uid
        && memberData().role == 'owner'
        && memberData().storeId is string
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && get(/databases/$(database)/documents/stores/$(storeId)).data.parentStoreId == memberData().storeId;
    }

    function hasStoreAccess(storeId) {
      return hasDirectStoreAccess(storeId) || hasLinkedOwnerStoreAccess(storeId);
    }

    function isStoreOwner(storeId) {
      return hasStoreAccess(storeId) && memberData().role == 'owner';
    }

    function ownerCanManageStore(storeId) {
      return hasMemberRecord()
        && memberData().role == 'owner'
        && hasStoreAccess(storeId);
    }

    function hasText(field, maxLength) {
      return field is string && field.size() > 0 && field.size() <= maxLength;
    }

    function isEngagementCommentCreate() {
      return hasText(request.resource.data.canonicalProductKey, 400)
        && hasText(request.resource.data.storeId, 180)
        && hasText(request.resource.data.sourceProductId, 220)
        && hasText(request.resource.data.body, 2000)
        && request.resource.data.status in ['pending', 'approved']
        && request.resource.data.visibility in ['public', 'store_only'];
    }

    function isEngagementFavoriteWrite() {
      return hasText(request.resource.data.canonicalProductKey, 400)
        && hasText(request.resource.data.storeId, 180)
        && hasText(request.resource.data.sourceProductId, 220)
        && hasText(request.resource.data.userId, 120)
        && request.resource.data.active is bool;
    }

    function isEngagementThreadWrite() {
      return hasText(request.resource.data.canonicalProductKey, 400)
        && hasText(request.resource.data.storeId, 180)
        && hasText(request.resource.data.sourceProductId, 220);
    }

    function isIntegrationOrderCreate() {
      return hasText(request.resource.data.storeId, 180)
        && hasText(request.resource.data.reference, 240)
        && request.resource.data.customer is map;
    }

    match /publicProducts/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /publicServices/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /storeSettings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /publicStores/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Membership is part of the security boundary for event planning. Users
    // may update their own non-access fields, but cannot move themselves to a
    // different store or promote their own role. Owners can manage members for
    // stores they own, including linked child stores.
    match /teamMembers/{memberId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        // Primary owner bootstrap.
        (
          request.resource.data.uid == request.auth.uid
          && request.resource.data.storeId == request.auth.uid
          && request.resource.data.role == 'owner'
        )
        // Back-compatible alias document for an already-authorized member.
        || (
          request.resource.data.uid == request.auth.uid
          && exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid))
          && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.storeId == request.resource.data.storeId
          && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.role == request.resource.data.role
        )
        // Owner-managed team member.
        || (
          request.resource.data.storeId is string
          && ownerCanManageStore(request.resource.data.storeId)
        )
      );

      allow update: if isSignedIn() && (
        (
          resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.storeId == resource.data.storeId
          && request.resource.data.role == resource.data.role
        )
        || (
          resource.data.storeId is string
          && ownerCanManageStore(resource.data.storeId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.storeId == resource.data.storeId
        )
      );

      allow delete: if isSignedIn()
        && resource.data.storeId is string
        && ownerCanManageStore(resource.data.storeId)
        && resource.data.uid != request.auth.uid;
    }

    match /stores/{storeId}/websiteHeroSlides/{slideId} {
      allow read, write: if isSignedIn();
    }

    // Event planning contains client, guest, vendor, contract and financial data.
    // Keep it isolated to the active store membership rather than the legacy
    // authenticated-user fallback used by older Sedifex collections.
    match /stores/{storeId}/events/{eventId} {
      allow read, create, update: if hasStoreAccess(storeId);
      allow delete: if isStoreOwner(storeId);
    }

    // Require one concrete segment below the event before the recursive
    // wildcard. Rules v2 recursive wildcards can match zero segments, so a
    // direct {eventDocument=**} here would also match the root event and OR its
    // delete permission with the owner-only rule above.
    match /stores/{storeId}/events/{eventId}/{eventCollection}/{document=**} {
      allow read, create, update, delete: if hasStoreAccess(storeId);
    }

    // Reusable contract templates contain store-specific legal and commercial
    // wording. Keep them inside the same membership boundary as event records.
    match /stores/{storeId}/eventContractTemplates/{templateId} {
      allow read, create, update, delete: if hasStoreAccess(storeId);
    }

    // Audit entries are append-only from the Admin SDK Cloud Function. Store
    // members can read them, but browser clients cannot alter audit history.
    match /stores/{storeId}/eventActivity/{activityId} {
      allow read: if hasStoreAccess(storeId);
      allow create, update, delete: if false;
    }

    // Secure public contract links contain bearer URLs and signing audit data.
    // They are accessed only through Admin SDK Cloud Functions. Never expose
    // these records directly to browser Firestore clients, including signed-in
    // users from other Sedifex stores.
    match /eventContractLinks/{linkId} {
      allow read, create, update, delete: if false;
    }

    // Client collaboration links are bearer credentials too. Public clients
    // only reach them through the Admin SDK HTTP/callable functions; browser
    // Firestore clients must never be able to enumerate or forge them.
    match /eventClientLinks/{linkId} {
      allow read, create, update, delete: if false;
    }

    // SMS queues and lifecycle event ledgers control billable outbound sends.
    // They are server-owned and must never be forged, deleted, or marked sent
    // by a browser client. Store-facing status is exposed through the normal
    // store notification/history collections instead.
    match /bookingSmsQueue/{docId} {
      allow read, create, update, delete: if false;
    }

    match /bookingSmsDeliveryQueue/{docId} {
      allow read, create, update, delete: if false;
    }

    match /bookingLifecycleSmsQueue/{docId} {
      allow read, create, update, delete: if false;
    }

    match /bookingLifecycleSmsEvents/{docId} {
      allow read, create, update, delete: if false;
    }

    match /engagement_threads/{threadId} {
      allow read: if true;
      allow create, update: if isEngagementThreadWrite() || isSignedIn();
      allow delete: if isSignedIn();
    }

    match /engagement_comments/{commentId} {
      allow read: if true;
      allow create: if isEngagementCommentCreate();
      allow update, delete: if isSignedIn();
    }

    match /engagement_favorites/{favoriteId} {
      allow read: if true;
      allow create, update: if isEngagementFavoriteWrite();
      allow delete: if isSignedIn();
    }

    match /integrationOrders/{docId} {
      allow create: if isIntegrationOrderCreate();
      allow read, update, delete: if isSignedIn();
    }

    match /integrationBookings/{docId} {
      allow create: if isIntegrationOrderCreate();
      allow read, update, delete: if isSignedIn();
    }

    match /checkoutRequests/{docId} {
      allow create: if request.resource.data.customer is map || request.resource.data.customerName is string;
      allow read, update, delete: if isSignedIn();
    }

    // Customer CRM records contain cross-module contact, financial, message,
    // note, and document metadata. Keep root customer records and all CRM
    // subcollections inside the same store-membership boundary.
    match /customers/{customerId} {
      allow read: if resource.data.storeId is string
        && hasStoreAccess(resource.data.storeId);

      allow create: if request.resource.data.storeId is string
        && hasStoreAccess(request.resource.data.storeId);

      allow update: if resource.data.storeId is string
        && request.resource.data.storeId == resource.data.storeId
        && hasStoreAccess(resource.data.storeId);

      allow delete: if resource.data.storeId is string
        && hasStoreAccess(resource.data.storeId);
    }

    match /customers/{customerId}/{crmCollection}/{document=**} {
      allow read, create, update, delete: if
        exists(/databases/$(database)/documents/customers/$(customerId))
        && get(/databases/$(database)/documents/customers/$(customerId)).data.storeId is string
        && hasStoreAccess(get(/databases/$(database)/documents/customers/$(customerId)).data.storeId);
    }

    // Store identity/link fields are trusted by linked-store event access.
    // Browser clients may maintain ordinary store settings, but they cannot
    // re-parent an existing store or rewrite ownership identifiers to gain
    // access to another store's event workspace. Server Admin SDK callables can
    // still create/manage linked stores because Admin writes bypass rules.
    match /stores/{storeId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && storeId == request.auth.uid
        && request.resource.data.storeId == storeId
        && request.resource.data.ownerUid == request.auth.uid
        && !('parentStoreId' in request.resource.data);

      allow update: if isSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'storeId',
          'ownerUid',
          'ownerId',
          'parentStoreId'
        ]);

      allow delete: if hasDirectStoreAccess(storeId)
        && memberData().role == 'owner';
    }

    // Preserve the legacy behavior for other store subcollections while
    // excluding event planning and event contract templates, which have
    // stricter multi-tenant rules above.
    match /stores/{storeId}/{subCollection}/{document=**} {
      allow read, write: if isSignedIn()
        && subCollection != 'events'
        && subCollection != 'eventActivity'
        && subCollection != 'eventContractTemplates';
    }

    // Legacy fallback for non-store-scoped collections. Store-scoped,
    // membership, CRM, secure bearer-link paths, and server-owned SMS queues
    // are intentionally excluded so their stricter rules cannot be bypassed by
    // an overlapping authenticated wildcard.
    match /{topCollection}/{document=**} {
      allow read, write: if isSignedIn()
        && topCollection != 'stores'
        && topCollection != 'teamMembers'
        && topCollection != 'customers'
        && topCollection != 'eventContractLinks'
        && topCollection != 'eventClientLinks'
        && topCollection != 'bookingSmsQueue'
        && topCollection != 'bookingSmsDeliveryQueue'
        && topCollection != 'bookingLifecycleSmsQueue'
        && topCollection != 'bookingLifecycleSmsEvents';
    }
  }
}